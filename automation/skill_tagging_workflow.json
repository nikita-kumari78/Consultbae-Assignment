{
  "name": "ConsultBae - Skill Category Auto-Tagging",
  "nodes": [
    {
      "parameters": {},
      "id": "3a1b1e10-0001-4a2a-9c1a-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.person_id, p.canonical_name, GROUP_CONCAT(DISTINCT s.skill SEPARATOR ', ') AS skills FROM people p JOIN skills s ON s.person_id = p.person_id WHERE p.skill_category IS NULL GROUP BY p.person_id, p.canonical_name;"
      },
      "id": "3a1b1e10-0001-4a2a-9c1a-000000000002",
      "name": "Get Untagged People",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [460, 300],
      "credentials": {
        "mySql": {
          "id": "1",
          "name": "ConsultBae MySQL"
        }
      }
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "3a1b1e10-0001-4a2a-9c1a-000000000003",
      "name": "Loop Over People",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"claude-sonnet-4-6\",\n  max_tokens: 20,\n  system: \"You classify a freelancer's skill list into exactly one category. Categories: automation (n8n, zapier, selenium, web scraping), web-dev (javascript, react, fastapi), data (sql, mysql, mongodb, pandas), ai-ml (langchain), backend-devops (python, docker, rest apis), other (anything that doesn't clearly fit). Respond with ONLY the category slug, nothing else.\",\n  messages: [\n    { role: \"user\", content: `Skills: ${$json.skills}` }\n  ]\n}) }}"
      },
      "id": "3a1b1e10-0001-4a2a-9c1a-000000000004",
      "name": "Classify Skill Category (LLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 220],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ALLOWED = ['automation', 'web-dev', 'data', 'ai-ml', 'backend-devops', 'other'];\n\nconst person = $('Loop Over People').item.json;\nconst llmResponse = $input.item.json;\n\nlet category = 'other';\ntry {\n  const raw = (llmResponse.content?.[0]?.text || '').trim().toLowerCase();\n  category = ALLOWED.includes(raw) ? raw : 'other';\n} catch (e) {\n  category = 'other';\n}\n\nreturn {\n  json: {\n    person_id: person.person_id,\n    canonical_name: person.canonical_name,\n    skill_category: category,\n    tagged_at: new Date().toISOString()\n  }\n};"
      },
      "id": "3a1b1e10-0001-4a2a-9c1a-000000000005",
      "name": "Parse & Validate Category",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 220]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE people SET skill_category = ?, skill_category_tagged_at = ? WHERE person_id = ?;",
        "options": {
          "queryReplacement": "={{ [$json.skill_category, $json.tagged_at, $json.person_id] }}"
        }
      },
      "id": "3a1b1e10-0001-4a2a-9c1a-000000000006",
      "name": "Update Person Category",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [1420, 220],
      "credentials": {
        "mySql": {
          "id": "1",
          "name": "ConsultBae MySQL"
        }
      }
    },
    {
      "parameters": {},
      "id": "3a1b1e10-0001-4a2a-9c1a-000000000007",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [940, 420]
    }
  ],
